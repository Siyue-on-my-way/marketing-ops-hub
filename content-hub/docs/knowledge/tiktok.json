      "url": "https://studio.tiktok.com/analytics",
      "fields": { "views": "Views", "likes": "Likes", "comments": "Comments", "shares": "Shares" }
    }
  },
  "interact": {
    "like": { "click_text": null, "click_sel": "[data-e2e='like-icon']" },
