    "dm": { "box_sel": null, "box_focus_text": null, "send_text": "Send", "send_sel": null },
    "follow": { "click_text": "Follow", "click_sel": null }
  },
  "risk": ["Captcha", "re:unusual activity|verify|blocked"],
  "cadence": { "post_gap_sec": [150, 300], "daily_post": 2, "interact_gap_sec": [30, 120] },
  "limits": { "caption_max": 2200 }
