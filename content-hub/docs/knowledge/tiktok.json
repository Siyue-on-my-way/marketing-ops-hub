      "display_name_sel": null
    },
    "publish": {
      "url": "https://studio.tiktok.com/upload",
      "upload_text": "Select file",
      "upload_sel": null,
      "file_input_sel": "input[type='file']",
      "form_ready_text": "Caption",
      "caption_sel": null,
      "caption_focus_text": "Caption",
      "submit_sel": null,
      "submit_text": "Post",
      "steps": [
        "点 Select file → waitForFileChooser → setFiles → 等处理",
        "填 Caption(≤2200, 话题并入) → 滚动到 Post 按钮 → 停（人不点，红线1）"
