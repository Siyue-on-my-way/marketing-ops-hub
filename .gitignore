# .env 真实密钥不入库
docker/.env
# 持久化数据不入库（保留目录占位）
docker/volumes/marketing-ops-hub/data/*
docker/volumes/marketing-ops-hub/workspace/*
docker/volumes/marketing-ops-hub/cloud-data/*
!docker/volumes/marketing-ops-hub/data/.gitkeep
!docker/volumes/marketing-ops-hub/workspace/.gitkeep
!docker/volumes/marketing-ops-hub/cloud-data/.gitkeep
# 运行期产物
backend/data/
backend/var/
runs/
shots/
cache/
node_modules/
*.log
