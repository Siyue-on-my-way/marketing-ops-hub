# ============ marketing-ops-hub 环境变量 ============
# 复制为 .env 使用（.env 不入库）；全部变量此处集中声明，值用占位符

# —— 网关 ——
# 对外端口（唯一对外入口）
GATEWAY_PORT=2680

# —— 访问令牌（必填）——
# 大屏/API 网关鉴权：重启后不变，保证入口 URL 稳定；访问大屏用 http://host:2680/?token=<SERVER_TOKEN>
SERVER_TOKEN=please-change-to-a-long-random-token

# —— 云素材库 maitian-cloud（必填）——
# workspace_key：一个 key 找到 workspace，key=全部权限；不进 git 不进聊天记录
MAITIAN_WORKSPACE_KEY=please-change-to-another-long-random-key
# 签名下载密钥（可选；缺省自动生成落 cloud-data/.sign_secret）
MAITIAN_SIGN_SECRET=

# —— 依赖镜像源（本项目后端零依赖，仅 frontend 构建保留统一模板）——
NPM_REGISTRY=https://registry.npmmirror.com
PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple

# —— 自托管模式 ——
# CLOUD_REQUIRED=0（本系统自托管云素材库，不强制登录云账号；模板占位保留）
CLOUD_REQUIRED=0
